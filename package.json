{
  "name": "melody-manager",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "./apps/client",
    "./apps/website"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/client dev",
    "build": "bun run --cwd apps/client build",
    "build:desktop": "bun run --cwd apps/client build:desktop",
    "preview": "bun run --cwd apps/client preview",
    "test": "bun run --cwd apps/client test",
    "test:e2e": "bun run --cwd apps/client test:e2e",
    "test:e2e:ui": "bun run --cwd apps/client test:e2e:ui",
    "type-check": "bun run --cwd apps/client type-check",
    "android": "bun run --cwd apps/client android",
    "cap:sync": "bun run --cwd apps/client cap:sync",
    "cap:add:android": "bun run --cwd apps/client cap:add:android",
    "cap:add:ios": "bun run --cwd apps/client cap:add:ios",
    "cap:open:android": "bun run --cwd apps/client cap:open:android",
    "cap:open:ios": "bun run --cwd apps/client cap:open:ios",
    "cap:run:android": "bun run --cwd apps/client cap:run:android",
    "cap:run:ios": "bun run --cwd apps/client cap:run:ios",
    "cap:assets": "bun run --cwd apps/client cap:assets"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "typescript": "6.0.3"
  }
}
