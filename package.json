{
  "name": "melody-manager",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "./apps/client",
    "./docs"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/client dev",
    "build": "bun run --cwd apps/client build",
    "build:desktop": "bun run --cwd apps/client build:desktop",
    "preview": "bun run --cwd apps/client preview",
    "test": "bun run --cwd apps/client test",
    "test:e2e": "bun run --cwd apps/client test:e2e",
    "test:e2e:ui": "bun run --cwd apps/client test:e2e:ui",
    "type-check": "bun run --cwd apps/client type-check",
    "android": "bun run build && bunx cap sync && cd android && ./gradlew assembleDebug",
    "cap:sync": "bunx cap sync",
    "cap:add:android": "bunx cap add android",
    "cap:add:ios": "bunx cap add ios",
    "cap:open:android": "bunx cap open android",
    "cap:open:ios": "bunx cap open ios",
    "cap:run:android": "bunx cap run android",
    "cap:run:ios": "bunx cap run ios",
    "cap:assets": "bunx @capacitor/assets generate --iconBackgroundColor '#7C3AED' --iconBackgroundColorDark '#7C3AED' --splashBackgroundColor '#7C3AED' --splashBackgroundColorDark '#7C3AED'"
  },
  "dependencies": {
    "@capacitor/android": "8.3.4",
    "@capacitor/cli": "8.4.0",
    "@capacitor/core": "8.4.0",
    "@capacitor/ios": "8.3.4",
    "@capacitor/preferences": "8.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@capacitor/assets": "^3.0.5",
    "typescript": "6.0.3"
  }
}
