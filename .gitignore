# .gitignore
# dependencies
node_modules
.pnp
.pnp.js

# testing
coverage

# production
dist
build
cookies/

# core dumps
core.*

# misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# editor directories and files
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Bun
bun.lockb
.turbo

# Tanstack
.tanstack

# Pocketbase
apps/api/pb_data
apps/server/pb_data

# Nix
.direnv

# Claude
.claude

# VitePress
apps/website/.vitepress/cache
apps/website/.vitepress/dist

# Android
apps/android/*.keystore
apps/android/*.jks
apps/android/app/release.keystore
apps/android/gradle.properties
apps/android/local.properties

# iOS
apps/ios/App/App/GoogleService-Info.plist

# Capacitor generated assets (auto-generated by CI)
apps/android/app/src/main/res/mipmap-*
apps/android/app/src/main/res/drawable-*
apps/ios/App/App/Assets.xcassets/AppIcon.appiconset/
apps/ios/App/App/Assets.xcassets/Splash.imageset/

# The native projects lived at the root before they moved into apps/. A
# checkout from before the move keeps what git never tracked there, a release
# keystore and local.properties among it, and none of it may be staged.
/android/
/ios/

# Operator configuration, generated on first run
apps/api/config/
apps/server/config/

# Compiled binaries: `task build:api` and `task desktop` both write here.
bin/

# Desktop client: the embedded bundle is a build artefact. Its parent folder is
# kept so `go:embed` resolves on a fresh clone, before anything has been built.
apps/desktop/frontend/dist/
apps/server/client/dist/

# `go build ./...` inside apps/desktop drops the binary beside its source.
apps/desktop/desktop

# Playwright: the throwaway server's database and the run's own output.
apps/client/e2e/.data/
apps/client/e2e/.artifacts/
apps/client/e2e/.report/
