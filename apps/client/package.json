{
  "name": "@melody-manager/client",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --mode desktop --outDir ../desktop/frontend/dist",
    "preview": "vite preview",
    "test": "bun test src",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "type-check": "tsc -b && tsc -b tsconfig.e2e.json",
    "android": "bun run build && bunx cap sync && cd ../android && ./gradlew assembleDebug",
    "cap:sync": "bunx cap sync",
    "cap:add:android": "bunx cap add android",
    "cap:add:ios": "bunx cap add ios",
    "cap:open:android": "bunx cap open android",
    "cap:open:ios": "bunx cap open ios",
    "cap:run:android": "bunx cap run android",
    "cap:run:ios": "bunx cap run ios",
    "cap:assets": "bunx @capacitor/assets generate --androidProject ../android --iosProject ../ios/App --iconBackgroundColor '#7C3AED' --iconBackgroundColorDark '#7C3AED' --splashBackgroundColor '#7C3AED' --splashBackgroundColorDark '#7C3AED'"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@jofr/capacitor-media-session": "^4.0.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-db": "0.5.12",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-table": "^8.21.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fuse.js": "7.5.0",
    "i18next": "26.3.1",
    "i18next-browser-languagedetector": "8.3.0",
    "lucide-react": "1.72.0",
    "nanoid": "6.0.2",
    "next-themes": "^0.4.6",
    "pocketbase": "^0.28.2",
    "pocketbase-db-collection": "0.2.0",
    "pocketbase-react-hooks": "^2.2.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-fast-marquee": "^1.6.5",
    "react-i18next": "17.0.8",
    "recharts": "3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "universal-client": "0.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@capacitor/assets": "^3.0.5",
    "@playwright/test": "1.65.0",
    "@rolldown/plugin-babel": "0.3.1",
    "@tanstack/router-plugin": "1.169.0",
    "@types/babel__core": "7.20.5",
    "@types/node": "25.9.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "1.3.0",
    "workbox-window": "7.4.1"
  }
}
